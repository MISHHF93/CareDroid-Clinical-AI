{
  "extends": [],
  "hints": {
    "*": "off",
    "axe/*": "off",
    "axe/aria": "off",
    "axe/forms": "off",
    "axe/keyboard": "off",
    "axe/name-role-value": "off",
    "axe/parsing": "off",
    "axe/semantics": "off",
    "axe/sensory-and-visual-cues": "off",
    "axe/structure": "off",
    "axe/tables": "off",
    "axe/text-alternatives": "off",
    "axe/language": "off",
    "compat-api/*": "off",
    "compat-api/html": "off",
    "compat-api/css": "off",
    "no-inline-styles": "off",
    "button-type": "off",
    "create-element-svg": "off",
    "disown-opener": "off",
    "highest-available-document-mode": "off",
    "meta-charset-utf-8": "off",
    "meta-viewport": "off",
    "no-protocol-relative-urls": "off",
    "typescript-config/*": "off",
    "typescript-config/is-valid": "off",
    "typescript-config/strict": "off",
    "typescript-config/target": "off",
    "typescript-config/consistent-casing": "off"
  }
}
