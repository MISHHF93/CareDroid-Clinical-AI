{
  "name": "caredroid-clinical-ai",
  "private": true,
  "version": "1.0.0",
  "description": "CareDroid — single-application ED operations platform (Vite + React + NestJS) with embedded clinical copilot",
  "type": "module",
  "packageManager": "npm@10",
  "engines": {
    "node": ">=20.19.0 <25",
    "npm": ">=10"
  },
  "scripts": {
    "start": "npm run dev:fullstack",
    "dev": "node scripts/dev-stack.mjs",
    "dev:web": "vite --strictPort",
    "dev:api": "node scripts/dev-stack.mjs --backend-only",
    "dev:fullstack": "node scripts/dev-stack.mjs",
    "dev:lan": "vite --strictPort --host",
    "clean": "node scripts/clean.mjs",
    "validate:assets": "node scripts/validate-assets.mjs",
    "build": "npm run validate:assets && vite build",
    "build:frontend": "npm run build",
    "validate:vercel-env": "node scripts/validate-vercel-env.mjs",
    "rebuild": "npm run clean && npm run build",
    "preview": "vite preview",
    "preview:lan": "vite preview --host",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:run:stable": "vitest run --pool=threads --maxWorkers=1",
    "test:integration": "jest tests/integration",
    "test:run:parallel": "node scripts/run-vitest-parallel.mjs",
    "test:run:frontend": "vitest run src",
    "test:pr6-fleet": "vitest run src/data/pr6FleetComprehensive.test.tsx src/data/prFleetConsistency.test.ts src/data/fleetCommandWiring.test.ts src/data/predictiveMaintenanceWiring.test.ts src/data/routeOptimizerWiring.test.ts src/data/dispatchAiWiring.test.ts src/pages/fleet src/services/fleetTelemetryService.test.ts src/services/predictiveMaintenanceScoring.test.ts src/services/routeOptimizationService.test.ts src/routes/clinicalToolRoutes.test.ts",
    "test:alias-sync": "vitest run src/data/clinicalToolAliasSync.test.ts",
    "test:catalog-launch": "vitest run src/data/clinicalCatalogLaunch.test.ts",
    "test:tool-render-smoke": "vitest run src/data/toolRenderExecuteMatrix.test.ts src/test/toolRenderExecuteSmoke.test.tsx src/test/routePagesSmoke.test.tsx src/pages/tools/Calculators.formSmoke.test.tsx",
    "tool-matrix:write-docs": "node scripts/write-tool-render-execute-matrix.mjs",
    "test:executor-mapping": "vitest run src/data/executorMappingAudit.test.ts src/data/unsupportedOrchestratorTools.test.ts src/data/clinicalToolIdContract.test.ts src/data/orchestratorMappingHardening.test.ts src/services/clinicalOrchestratorApi.test.ts",
    "orchestrator:write-docs": "node scripts/write-unsupported-orchestrator-docs.mjs",
    "test:safety-compliance": "vitest run src/data/clinicalSafetyGuardrails.test.ts src/data/clinicalSafetyCompliance.report.test.ts",
    "safety-compliance:report": "node scripts/print-clinical-safety-report.mjs",
    "test:e2e-matrix": "vitest run src/data/e2eToolValidationMatrix.test.ts",
    "e2e-matrix:report": "node scripts/print-e2e-matrix-report.mjs",
    "e2e-matrix:write-docs": "node scripts/write-e2e-docs.mjs",
    "inventory:report": "node scripts/print-platform-inventory.mjs",
    "inventory:write-docs": "npx tsx scripts/write-platform-inventory.mjs",
    "inventory:visual-cleanup": "node scripts/visual-cleanup-inventory.mjs",
    "normalize:medical": "node scripts/normalize-medical-full-scale.mjs && node scripts/normalize-medical-colors.mjs && node scripts/normalize-medical-text.mjs && node scripts/normalize-card-contrast.mjs && node scripts/normalize-platform-theme.mjs",
    "split:large-css": "node scripts/split-large-css.mjs",
    "check:inline-styles": "node scripts/check-inline-styles.mjs",
    "test:visibility-matrix": "vitest run src/data/toolVisibilityMatrix.test.ts",
    "test:registry-launch": "vitest run src/navigation/registryToolLaunch.test.ts src/routes/clinicalToolRoutes.test.ts",
    "test:route-tree-redirects": "node node_modules/vitest/vitest.mjs run --config vitest.route-tree.config.ts",
    "test:tools-routes": "node node_modules/vitest/vitest.mjs run src/routing/canonicalRouteTree.redirects.test.tsx src/config/toolsConsoleRoutes.test.ts src/pages/tools/Calculators.route.test.tsx --maxWorkers=1 --pool=forks --hookTimeout=120000 --testTimeout=60000",
    "test:governance-routes": "node node_modules/vitest/vitest.mjs run src/routing/canonicalRouteTree.redirects.test.tsx src/config/governanceConsoleRoutes.test.ts src/pages/platform/PlatformGovernanceWorkspace.test.tsx --maxWorkers=1 --pool=forks --hookTimeout=120000 --testTimeout=60000",
    "test:redirect-parity": "node node_modules/vitest/vitest.mjs run src/config/inShellRouteAllowlist.test.ts src/config/edApplication.config.test.ts src/routing/canonicalRouteRedirects.test.ts src/routing/routeAliasFixtures.test.ts src/routing/canonicalRouteTree.shell.test.tsx --maxWorkers=1",
    "test:cohesion-security": "node node_modules/vitest/vitest.mjs run src/config/platformCohesion.contract.test.ts src/config/security.contract.test.ts src/components/account/ProfileRoleSwitcher.test.tsx --maxWorkers=1",
    "test:deep-link": "node node_modules/vitest/vitest.mjs run src/routing/canonicalAppRoutes.deepLink.test.tsx src/config/platformCohesion.contract.test.ts --maxWorkers=1 --testTimeout=60000",
    "test:cohesion-full": "npm run test:cohesion-security && npm run test:deep-link",
    "test:platform-routes": "node node_modules/vitest/vitest.mjs run src/config/platformConsoleRoutes.test.ts src/config/platformStubPolicy.test.ts src/routing/canonicalRouteTree.redirects.test.tsx --maxWorkers=1 --pool=forks --hookTimeout=120000 --testTimeout=60000",
    "test:training-routes": "node node_modules/vitest/vitest.mjs run src/config/trainingConsoleRoutes.test.ts src/routing/canonicalRouteTree.redirects.test.tsx --maxWorkers=1 --pool=forks --hookTimeout=120000 --testTimeout=60000",
    "test:operations-routes": "node node_modules/vitest/vitest.mjs run src/config/operationsFleetConsoleRoutes.test.ts src/routing/canonicalRouteTree.redirects.test.tsx --maxWorkers=1 --pool=forks --hookTimeout=120000 --testTimeout=60000",
    "test:profile-routes": "node node_modules/vitest/vitest.mjs run src/config/profileConsoleRoutes.test.ts --maxWorkers=1",
    "test:admin-routes": "node node_modules/vitest/vitest.mjs run src/config/adminConsoleRoutes.test.ts --maxWorkers=1",
    "visibility-matrix:report": "node scripts/print-visibility-matrix-report.mjs",
    "visibility-matrix:write-docs": "node scripts/write-tool-visibility-matrix.mjs",
    "feature-coverage-matrix:write-docs": "node scripts/write-feature-coverage-matrix.mjs",
    "saas-compliance-audit:write-docs": "node scripts/write-saas-compliance-audit.mjs",
    "saas-bottleneck-audit:write-docs": "node scripts/write-saas-bottleneck-implementation-audit.mjs",
    "orphan-detection:write-docs": "node scripts/write-orphan-detection-report.mjs",
    "duplicate-system-audit:write-docs": "node scripts/write-duplicate-system-audit.mjs",
    "product-packaging-audit:write-docs": "node scripts/write-product-packaging-audit.mjs",
    "closure-audit:write-docs": "node scripts/run-closure-audit-sequence.mjs",
    "contract:write-docs": "node scripts/write-backend-frontend-tool-contract.mjs",
    "test:contract-matrix": "vitest run src/data/backendFrontendToolContract.test.ts src/data/backendFrontendToolContract.report.test.ts src/data/toolContractMatrix.test.ts",
    "test:backend-exposure": "vitest run src/data/backendFrontendExposure.test.ts src/data/backendFrontendExposure.report.test.ts src/data/backendFrontendToolContract.test.ts src/data/executorMappingAudit.test.ts src/data/backendOrphanAudit.test.ts src/data/backendControllerRouteScan.test.ts src/config/backendApiCapabilities.test.ts src/services/clinicalOrchestratorApi.test.ts src/services/clinicalToolsApi.test.ts src/services/complianceApi.test.ts",
    "exposure:write-docs": "node scripts/write-backend-exposure-report.mjs",
    "alias-sync:report": "node scripts/print-alias-sync-report.mjs",
    "qa:responsive": "node scripts/run-responsive-qa.mjs",
    "qa:responsive:retry": "node scripts/retry-responsive-qa-failures.mjs",
    "qa:responsive:report": "node scripts/write-responsive-qa-report.mjs",
    "qa:page-screenshots": "node scripts/capture-emergency-page-screenshots.mjs",
    "qa:shell-responsive": "node scripts/capture-shell-responsive-screenshots.mjs",
    "qa:shell-responsive:preview": "npm run build && node scripts/capture-shell-responsive-screenshots.mjs",
    "qa:dashboard-resize": "node scripts/capture-dashboard-resize-audit.mjs",
    "test:responsive-regression": "vitest run src/test/routePagesSmoke.test.tsx src/test/responsiveRegression.coverage.test.ts src/pages/tools/ClinicalToolCatalog.launchButtons.test.tsx src/pages/tools/Calculators.formSmoke.test.tsx src/layout/AppShell.navigation.test.tsx src/pages/tools/ClinicalToolCatalog.responsive.test.ts src/pages/tools/Calculators.responsive.test.ts src/styles/responsiveUx.test.ts src/layout/AppShell.layout.test.tsx",
    "test:mobile-performance": "vitest run src/styles/mobilePerformance.test.ts",
    "qa:responsive:chromium": "playwright test e2e/responsive-qa.spec.mjs --config=playwright.config.mjs --project=chromium",
    "test:e2e:responsive": "playwright test e2e/responsive-qa.spec.mjs",
    "test:e2e:production": "playwright test e2e/production-smoke.spec.mjs --config=playwright.production.config.mjs",
    "test:coverage": "vitest run --coverage",
    "test:frontend": "vitest",
    "backend:dev": "node scripts/dev-stack.mjs --backend-only",
    "backend:build": "cd backend && npm run build",
    "backend:start": "cd backend && npm run start:prod",
    "start:backend": "npm run dev:api",
    "start:all": "npm run dev:fullstack",
    "compose:app": "docker compose -f docker-compose.app.yml up",
    "compose:app:build": "docker compose -f docker-compose.app.yml up --build",
    "compose:app:ml": "docker compose -f docker-compose.app.yml -f docker-compose.ml.yml --profile ml up --build",
    "compose:app:down": "docker compose -f docker-compose.app.yml down",
    "mcp:server": "cd mcp && npm run start",
    "smoke": "node scripts/print-smoke-checklist.mjs",
    "verify:stack": "node scripts/verify-stack-connection.mjs",
    "verify:ai-stack": "node scripts/verify-ai-stack.mjs",
    "verify:rag": "node scripts/verify-rag.mjs",
    "verify:safety": "node scripts/verify-safety-rules.mjs",
    "verify:ts-backend": "node scripts/verify-ts-backend.mjs",
    "lint": "eslint src",
    "lint:all": "npm run lint && cd backend && npm run lint",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,json,css}\"",
    "typecheck:frontend": "tsc --noEmit -p tsconfig.frontend.json",
    "test:all": "npm run test:run:frontend && cd backend && npm test",
    "test:bundle-budget": "vitest run src/build/bundleBudget.test.ts",
    "build:analyze": "npm run build && node scripts/analyze-bundle.mjs",
    "validate:ci": "npm run lint:all && npm run typecheck:frontend && npm run test:alias-sync && npm run test:catalog-launch && npm run test:registry-launch && npm run test:executor-mapping && npm run test:contract-matrix && npm run test:backend-exposure && npm run test:e2e-matrix && npm run test:tool-render-smoke && npm run test:safety-compliance && npm run test:visibility-matrix && npm run test:responsive-regression && npm run test:mobile-performance && vitest run src/data/toolRegistry.test.ts src/data/clinicalCatalogWiring.test.ts src/data/frontendApiCallsInventory.schedule.test.ts src/services/apiClient.auth.test.ts src/services/clinicalOrchestratorApi.registry.test.ts src/components/ChatInterface.nlu.test.tsx src/test/ExportService.test.ts && cd backend && npm run build && npm test && npm run test:e2e && cd .. && npm run build && npm run test:bundle-budget",
    "validate:responsive": "playwright test e2e/responsive-qa.spec.mjs --config=playwright.config.mjs --project=chromium",
    "start:single": "node scripts/run-single-production.mjs",
    "plans:write-backlog": "node scripts/write-plan-implementation-backlog.mjs",
    "plans:scan-battery": "node scripts/run-plan-scan-battery.mjs",
    "plans:write-progress": "node scripts/write-plan-progress-dashboard.mjs",
    "artifact-intelligence:generate": "node scripts/generate-artifact-intelligence.mjs",
    "train:unified-models": "node scripts/train-unified-models.mjs",
    "sync:unified-models": "node scripts/sync-unified-models.mjs",
    "docs:generate": "node scripts/generate-living-documentation.mjs",
    "docs:check": "node scripts/check-living-documentation.mjs",
    "test:living-docs": "vitest run src/config/livingDocumentationModel.test.ts src/services/livingDocumentationService.test.ts && npm run docs:check",
    "test:canonical-config": "vitest run src/config/canonicalConfiguration.contract.test.ts && node scripts/check-canonical-configuration.mjs",
    "test:observability": "vitest run src/config/observability.contract.test.ts src/config/observabilityWorkflowCoverage.contract.test.ts src/services/observabilityService.test.ts src/services/observabilityTrace.test.ts",
    "test:security": "vitest run src/config/security.contract.test.ts src/config/securityPermissionBridge.test.ts src/config/securityPermissionCoverage.contract.test.ts src/lib/users/backendRolePermissions.test.ts",
    "test:cohesion": "vitest run src/config/platformCohesion.contract.test.ts src/data/duplicateSystemAudit.report.test.ts src/config/canonicalConfiguration.contract.test.ts",
    "migrate:unified": "node scripts/run-unified-migration.mjs",
    "qa:operational-survivability": "node scripts/run-operational-survivability-audits.mjs",
    "qa:reception-swarm": "node scripts/receptionist-worker-swarm.mjs",
    "qa:reception-throughput": "node scripts/reception-throughput-simulation.mjs",
    "qa:reception-training": "node scripts/reception-training-audit.mjs",
    "qa:survivability-kpis": "node scripts/operational-survivability-kpis.mjs",
    "qa:trackmind-maturity": "node scripts/trackmind-maturity-audit.mjs",
    "qa:customer-success": "node scripts/customer-success-platform-audit.mjs",
    "qa:enterprise-platform": "node scripts/enterprise-operating-platform-audit.mjs",
    "qa:platform-intelligence": "node scripts/platform-intelligence-audit.mjs"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.44.0",
    "axios": "^1.16.1",
    "dexie": "^4.3.0",
    "firebase": "^12.13.0",
    "lucide-react": "^0.468.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.1.9",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.33.2",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "jiti": "^2.7.0",
    "jsdom": "^28.0.0",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.2.4",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "terser": "^5.47.1",
    "ts-jest": "^29.4.11",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "glob": "^13.0.6",
    "vite": {
      "rollup": "npm:@rollup/wasm-node@4.61.1"
    },
    "vitest": {
      "rollup": "npm:@rollup/wasm-node@4.61.1"
    },
    "rollup": "npm:@rollup/wasm-node@4.61.1"
  }
}
