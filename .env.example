# CareDroid Environment Configuration
# Copy to .env and update values

# ================================
# Application & Server
# ================================
NODE_ENV=development
# Documentation only — Vite dev uses port 8000 via package.json. Nest API PORT lives in backend/.env (default 3000).
# PORT=8000
# Frontend: `npm run dev` (Vite, default port 8000) proxies `/api` to the Nest backend (see vite.config.js).
# Fresh production bundle: `npm run rebuild` then `npm run preview` or `preview:lan` (port 8000, same proxy).
# Use empty VITE_API_URL for same-origin + Vite proxy; set a full URL only for a separate API host.
# Vercel frontend deploys are split API deploys by default and require VITE_API_URL.
# Leave empty in local dev so Vite proxies /api to Nest on :3000 (see vite.config.js)
VITE_API_URL=
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_ANTHROPIC_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set true only when the deployed SPA origin has a verified edge/reverse proxy forwarding /api to Nest.
VITE_ALLOW_SAME_ORIGIN_API=false
# Required if VITE_ALLOW_SAME_ORIGIN_API=true in deployed environments.
VITE_SAME_ORIGIN_API_PROXY_VERIFIED=false
# WebSocket origin when split from the SPA (optional; defaults to same host as the page)
VITE_WS_URL=
# Vite dev/preview proxy target (Nest default :3000). Not used in production static builds.
VITE_API_PROXY_TARGET=http://localhost:3000
# Fetch timeout for apiClient (milliseconds)
VITE_API_TIMEOUT_MS=30000
VITE_APP_NAME=CareDroid-Clinical-AI
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=development
VITE_APP_BUILD_DATE=2026-01-31
# Optional explicit build metadata. Vite injects Git/Vercel metadata automatically when available.
VITE_GIT_COMMIT_SHA=
VITE_GIT_BRANCH=
VITE_GIT_REPOSITORY=
VITE_BUILD_TIME=

# ================================
# Frontend Feature Flags (VITE_*)
# ================================
VITE_ENABLE_CRASH_REPORTING=true
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_PROFILES_SAMPLE_RATE=0.1
VITE_DEBUG=false
VITE_LOG_LEVEL=info

VITE_ENABLE_ANALYTICS=true
VITE_SEGMENT_WRITE_KEY=

VITE_ENABLE_PUSH_NOTIFICATIONS=true
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_BIOMETRIC_AUTH=true
# Local/demo visible "Direct Sign In" button on `/` and `/auth`.
# Local Vite defaults to true. Hosted demo deployments must also set VITE_DEMO_MODE=true.
VITE_ENABLE_DEV_AUTH_BYPASS=true
# Shows the "Continue in Demo Mode" button on /auth for hosted demos.
VITE_DEMO_MODE=true
# Local fallback demo tokens are dev-only by default. Hosted demos should use backend /api/auth/dev-session.
VITE_ALLOW_LOCAL_DEMO_AUTH=true
VITE_DEV_BEARER_TOKEN=dev-token-for-testing
# Legacy flags retained for older builds; explicit dev/demo access now uses VITE_ENABLE_DEV_AUTH_BYPASS.
# Show "Demo / Local Dev Mode" quick sign-in on /auth even in production builds (e.g. staging/demo). Default: false.
VITE_SHOW_DEMO_AUTH=false
# Hide Division mode (instant bypass) on /auth. Production bundles default to hidden when unset.
VITE_HIDE_DIVISION_MODE=false

# ================================
# Database (SQLite - Dev, PostgreSQL - Prod)
# ================================
DATABASE_CLIENT=sqlite
SQLITE_PATH=caredroid.sqlite

# PostgreSQL (Production)
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://user:password@localhost:5432/caredroid

# ================================
# Security
# ================================
JWT_SECRET=change_this_to_32_character_random_string_in_production
ENCRYPTION_KEY=change_this_to_32_byte_hex_key_for_aes_256_0123456789ABCDEF

# ================================
# Authentication (Optional)
# ================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:3000/api/auth/linkedin/callback

# ================================
# Unified AI Client
# ================================
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
AI_PROVIDER=anthropic
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2000
AI_ENABLED=false
ED_COPILOT_AI_ENABLED=true
SMART_INTAKE_AI_ENABLED=false
REFERRAL_AI_ENABLED=false
ANALYTICS_AI_ENABLED=false
CLINICAL_WORKFLOW_AI_ENABLED=false
AI_AUDIT_LOGGING_ENABLED=true
AI_PATIENT_CONTEXT_ENABLED=false
# Browser builds never receive provider API keys or direct model names; frontend AI calls go through backend APIs.

# ================================
# Clinical Reference APIs (Optional)
# ================================
VITE_FDA_API_KEY=
VITE_NIH_API_KEY=
VITE_PUBMED_API_KEY=

# ================================
# Firebase (Optional - for analytics in production)
# ================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=

# ================================
# Legal URLs
# ================================
VITE_PRIVACY_POLICY_URL=http://localhost:8000/privacy
VITE_TERMS_OF_SERVICE_URL=http://localhost:8000/terms
VITE_SUPPORT_URL=http://localhost:8000/support
VITE_HIPAA_BAA_URL=http://localhost:8000/hipaa-baa
# ================================
# Monitoring & Observability (Batch 13)
# ================================

# Sentry Error Tracking
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs
LOG_MAX_SIZE=20m
LOG_MAX_DAYS_COMBINED=7
LOG_MAX_DAYS_ERRORS=14
LOG_MAX_DAYS_PROD_COMBINED=30
LOG_MAX_DAYS_PROD_ERRORS=60

# Monitoring Stack (Docker Compose)
# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PASSWORD=admin
GRAFANA_USER=admin
GRAFANA_PORT=3001

# Kibana (Elasticsearch UI)
KIBANA_PORT=5601

# Sentry (Local Instance)
SENTRY_SECRET_KEY=your-secret-key-change-in-production
SENTRY_LOCAL_PORT=9000

# Redis (for Sentry and caching)
REDIS_PASSWORD=redis123
REDIS_PORT=6379

# Database (PostgreSQL for Sentry)
DB_NAME=caredroid
DB_USER=postgres
DB_PASSWORD=secure123
DB_PORT=5432

# Mail (for Sentry notifications)
MAIL_HOST=localhost
MAIL_PORT=1025

# ================================
# Alert Integrations (Batch 13 Phase 2)
# ================================

# Alertmanager Configuration
ALERTMANAGER_RESOLVE_TIMEOUT=5m

# Slack Alert Integration
# Get webhook URL from: https://api.slack.com/messaging/webhooks
ALERTMANAGER_SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email Alert Integration (SMTP)
ALERTMANAGER_EMAIL_FROM=alerts@caredroid.local
ALERTMANAGER_EMAIL_TO=ops@caredroid.local
ALERTMANAGER_SMTP_HOST=localhost
ALERTMANAGER_SMTP_PORT=25
ALERTMANAGER_SMTP_USER=
ALERTMANAGER_SMTP_PASSWORD=

# PagerDuty Integration
# Get integration key: https://yoursubdomain.pagerduty.com/integrations
ALERTMANAGER_PAGERDUTY_KEY=