{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "./dist"
  },
  "include": [
    "src/**/*",
    "ml-services/**/*",
    "../lib/**/*",
    "../src/types/**/*",
    "../types/**/*",
    "../src/config/user-profile-catalog.data.json"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*.spec.ts",
    "**/*.test.ts",
    "../lib/**/*.test.ts",
    "../src/store/**/*",
    "../src/components/**/*",
    "../src/pages/**/*",
    "../src/hooks/**/*",
    "../src/services/**/*",
    "../src/utils/**/*",
    "../src/engine/**/*",
    "../lib/ai/client.ts",
    "../lib/ai/responseParser.ts",
    "../engine/**/*",
    "../store/**/*"
  ]
}
