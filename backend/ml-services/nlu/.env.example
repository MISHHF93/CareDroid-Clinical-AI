# NLU Service Environment Variables

# Inference runs inside Nest at /api/nlu (TypeScript). These legacy host/port vars are unused.
# Set NLU_SERVICE_MODE=http only if you deploy a separate NLU HTTP service.

# Training pipeline (training/training.config.ts) — scripts/{prepareData,train,evaluate}.ts
NLU_EMBEDDING_MODEL=Xenova/all-mpnet-base-v2
NLU_MAX_LENGTH=512
NLU_EPOCHS=6000
NLU_LEARNING_RATE=0.3
NLU_L2_REG=0.0002
NLU_SEED=42

# Data/model paths (both training and inference)
NLU_TRAINING_DATA=./data/train.jsonl
NLU_VALIDATION_DATA=./data/val.jsonl
NLU_TEST_DATA=./data/test.jsonl
NLU_METRICS_OUTPUT=./metrics.json
NLU_BEST_MODEL_DIR=./models/best_model
