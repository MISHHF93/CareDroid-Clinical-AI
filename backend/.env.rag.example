# RAG System Environment Variables

# ====================
# ENABLEMENT
# ====================
RAG_ENABLED=true
# Auto-ingest data/medical-knowledge on startup when using in-memory local store
RAG_AUTO_BOOTSTRAP_CORPUS=true

# ====================
# PINECONE (optional — omit API key to use in-memory local store in dev)
# ====================
PINECONE_API_KEY=
PINECONE_INDEX_NAME=caredroid-medical-knowledge
PINECONE_NAMESPACE=medical-docs
PINECONE_DIMENSION=768
PINECONE_ENVIRONMENT=us-east-1-aws

# ====================
# EMBEDDINGS
# ====================
RAG_MODEL=Xenova/all-mpnet-base-v2
EMBEDDING_MODEL=Xenova/all-mpnet-base-v2
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=100

# ====================
# CHUNKING
# ====================
CHUNK_SIZE=512
CHUNK_OVERLAP=50
CHUNK_RESPECT_BOUNDARIES=true

# ====================
# RETRIEVAL
# ====================
RAG_TOP_K=5
RAG_MIN_SCORE=0.65
RAG_MAX_TOKENS=2000

# ====================
# RERANKING (optional)
# ====================
RERANK_ENABLED=false
RERANK_MODEL=local-keyword-reranker

# ====================
# QUICK START (local, no Pinecone)
# ====================
# 1. Set RAG_ENABLED=true (no PINECONE_API_KEY required)
# 2. Start backend — starter corpus auto-ingests from data/medical-knowledge/
# 3. Verify: npm run verify:rag
# 4. Manual ingest: npm run ingest -- --directory ../data/medical-knowledge --type guideline