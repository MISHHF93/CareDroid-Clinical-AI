{
  "name": "caredroid-clinical-ai-backend",
  "version": "1.0.0",
  "description": "CareDroid backend — emergency OS APIs, tool orchestration, RBAC, and audit-minded SaaS services",
  "author": "CareDroid Team",
  "private": true,
  "license": "PROPRIETARY",
  "engines": {
    "node": ">=20.19.0 <25",
    "npm": ">=10"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "postbuild": "node scripts/link-main.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "npm run start:prod",
    "start:dev": "npm run build && npm run start:prod",
    "start:watch": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/backend/src/main.js",
    "lint": "node scripts/run-eslint.mjs",
    "lint:fix": "node scripts/run-eslint.mjs --fix",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "typeorm-ts-node-commonjs -d src/data-source.ts",
    "migration:generate": "typeorm-ts-node-commonjs -d src/data-source.ts migration:generate",
    "migration:run": "typeorm-ts-node-commonjs -d src/data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d src/data-source.ts migration:revert",
    "ingest": "ts-node scripts/ingest-documents.ts",
    "nlu:prepare-data": "ts-node ml-services/nlu/scripts/prepareData.ts",
    "nlu:train": "ts-node ml-services/nlu/scripts/train.ts",
    "nlu:evaluate": "ts-node ml-services/nlu/scripts/evaluate.ts",
    "nlu:load-test": "ts-node ml-services/nlu/scripts/loadTest.ts",
    "nlu:cross-validate": "ts-node ml-services/nlu/scripts/crossValidate.ts",
    "nlu:augment-artifacts": "ts-node ml-services/nlu/scripts/augmentFromArtifacts.ts",
    "nlu:pipeline": "npm run nlu:augment-artifacts && npm run nlu:prepare-data && npm run nlu:train && npm run nlu:evaluate",
    "artifact-router:prepare-data": "ts-node ml-services/artifact-router/scripts/prepareData.ts",
    "artifact-router:train": "ts-node ml-services/artifact-router/scripts/train.ts",
    "artifact-router:evaluate": "ts-node ml-services/artifact-router/scripts/evaluate.ts",
    "artifact-router:pipeline": "npm run artifact-router:prepare-data && npm run artifact-router:train && npm run artifact-router:evaluate",
    "train:unified-models": "node ../scripts/train-unified-models.mjs",
    "sync:unified-models": "node ../scripts/sync-unified-models.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "@pinecone-database/pinecone": "^6.1.4",
    "@sentry/node": "^10.64.0",
    "@xenova/transformers": "^2.17.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dayjs": "^1.11.10",
    "dd-trace": "^5.37.0",
    "express-rate-limit": "^7.1.5",
    "firebase-admin": "^14.1.0",
    "glob": "^13.0.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "joi": "^17.11.0",
    "jws": "^4.0.1",
    "mongoose": "^9.7.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-linkedin-oauth2": "^2.0.0",
    "pg": "^8.11.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "qs": "^6.14.1",
    "redis": "^4.6.12",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "speakeasy": "^2.0.0",
    "sqlite3": "^5.0.2",
    "stripe": "^14.10.0",
    "tar": "^7.5.7",
    "tiktoken": "^1.0.22",
    "typeorm": "^0.3.30",
    "validator": "^13.15.26",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-google-oauth20": "^2.0.14",
    "@types/passport-jwt": "^3.0.13",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.5",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.6"
  },
  "overrides": {
    "sqlite3": {
      "node-gyp": "^13.0.1",
      "tar": "^7.5.19"
    },
    "uuid": "^11.1.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "src",
      "test",
      "ml-services"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "baseUrl": "./",
            "paths": {
              "@/*": [
                "src/*"
              ],
              "@modules/*": [
                "src/modules/*"
              ],
              "@common/*": [
                "src/common/*"
              ],
              "@config/*": [
                "src/config/*"
              ]
            }
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.spec.ts",
      "!src/**/index.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "silent": true,
    "setupFilesAfterEnv": [
      "<rootDir>/test/jest-setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@modules/(.*)$": "<rootDir>/src/modules/$1",
      "^@common/(.*)$": "<rootDir>/src/common/$1",
      "^@config/(.*)$": "<rootDir>/src/config/$1"
    }
  }
}
