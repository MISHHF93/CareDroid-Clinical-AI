{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "index.html",
        "scripts/**/*.mjs",
        "e2e/**/*.spec.mjs",
        "e2e/*.helpers.mjs"
      ],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.mjs", "e2e/**/*.mjs"]
    },
    "backend": {
      "entry": [
        "src/main.ts",
        "src/**/*.module.ts",
        "src/database/migrations/*.ts",
        "src/**/*.spec.ts",
        "test/**/*.e2e-spec.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  }
}
