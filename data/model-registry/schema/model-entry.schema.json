{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caredroid.local/schemas/model-registry-entry-v1.json",
  "title": "CareDroid Model Registry Entry v1",
  "type": "object",
  "required": [
    "id",
    "displayName",
    "kind",
    "status",
    "purpose",
    "prohibitedUses",
    "owner",
    "reviewers",
    "regulatoryClass",
    "jurisdictions",
    "limitations",
    "deployment",
    "expiresAt",
    "retirementPlan"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^mdl-[a-z0-9-]+-v[0-9]+$" },
    "displayName": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": [
        "foundation_llm",
        "local_classifier",
        "heuristic_rules",
        "deterministic_calculator",
        "embedding",
        "eval_harness",
        "other"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["approved", "shadow", "canary", "deprecated", "retired", "experimental"]
    },
    "purpose": { "type": "string" },
    "prohibitedUses": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "owner": { "type": "string" },
    "reviewers": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "trainingDataLineage": { "type": "string" },
    "benchmarkResults": {
      "type": "object",
      "additionalProperties": true
    },
    "regulatoryClass": {
      "type": "string",
      "enum": [
        "informational_cds",
        "non_device_cds",
        "operational_support",
        "eval_only",
        "not_assessed"
      ]
    },
    "jurisdictions": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "deployment": {
      "type": "object",
      "required": ["environments", "featureFlag", "rollback"],
      "properties": {
        "environments": {
          "type": "array",
          "items": { "type": "string", "enum": ["dev", "sim", "shadow", "canary", "prod"] }
        },
        "featureFlag": { "type": "string" },
        "canaryPercentDefault": { "type": "number", "minimum": 0, "maximum": 100 },
        "rollback": { "type": "string" },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["at", "event", "actor"],
            "properties": {
              "at": { "type": "string" },
              "event": { "type": "string" },
              "actor": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "expiresAt": { "type": "string" },
    "retirementPlan": { "type": "string" },
    "provider": { "type": "string" },
    "modelIdentifier": { "type": "string" },
    "relatedServiceIds": { "type": "array", "items": { "type": "string" } },
    "relatedPaths": { "type": "array", "items": { "type": "string" } }
  }
}
